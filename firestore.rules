rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Store info - anyone can read, only owner can write
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == storeId;
    }

    // Users - only the user themselves can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Categories - anyone can read, only authenticated admin can write
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Menus - anyone can read available menus, only admin can write
    match /menus/{menuId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Tables - anyone can read, only admin can write
    match /tables/{tableId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Orders - anyone can create & read, only admin can update
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null;
    }
  }
}
